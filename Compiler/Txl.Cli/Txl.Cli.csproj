<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>txl</AssemblyName>
    <RootNamespace>Txl</RootNamespace>
    <Version>0.9.0</Version>
    <PackageId>Txl.Cli</PackageId>
    <PackageVersion>0.9.0</PackageVersion>
    <Authors>Timexo</Authors>
    <Description>TXL compiler and CLI for native Windows WPF desktop applications.</Description>
    <PackageTags>TXL;compiler;WPF;Windows;CLI</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>txl</ToolCommandName>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Txl.Tests" />
    <None Update="Assets/txl.ico" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../../README.md" Pack="true" PackagePath="README.md" />
  </ItemGroup>
</Project>
